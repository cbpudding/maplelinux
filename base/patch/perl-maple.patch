diff -ruN vanilla/ext/Errno/Errno_pm.PL maple/ext/Errno/Errno_pm.PL
--- vanilla/ext/Errno/Errno_pm.PL	2026-07-27 20:05:55.364404904 -0400
+++ maple/ext/Errno/Errno_pm.PL	2026-07-27 20:08:20.120568265 -0400
@@ -115,7 +115,7 @@
 	# Some Linuxes have weird errno.hs which generate
 	# no #file or #line directives
 	($linux_errno_h) = grep { -e $_ } map { "$_/errno.h" }
-	    "$sysroot/usr/include", "$sysroot/usr/local/include",
+	    "$sysroot/share/include", "$sysroot/share/local/include",
 	    split / / => $Config{locincpth};
     }
 
@@ -126,7 +126,7 @@
 	# OS/390 C compiler doesn't generate #file or #line directives
         # and it does not tag the header as 1047 (EBCDIC), so make a local
         # copy and tag it
-        my $cp = `cp /usr/include/errno.h ./errno.h`;
+        my $cp = `cp /share/include/errno.h ./errno.h`;
         my $chtag = `chtag -t -cIBM-1047 ./errno.h`;
 	push(@file, './errno.h');
     } elsif ($Config{archname} eq 'arm-riscos') {
