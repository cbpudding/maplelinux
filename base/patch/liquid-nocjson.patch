+local function table_match(a, b)
+    local keys = {}
+
+    for k, _ in pairs(a) do
+        keys[k] = true
+    end
+
+    for k, _ in pairs(b) do
+        if not keys[k] then
+            return false
+        end
+    end
+
+    for k, _ in pairs(keys) do
+        if type(a[k]) == "table" and type(b[k]) == "table" then
+            if not table_match(a[k], b[k]) then
+                return false
+            end
+        elseif a[k] ~= b[k] then
+            return false
+        end
+    end
+
+    return true
+end
+
